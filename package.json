{
  "name": "hirematch-ai-root",
  "version": "1.0.0",
  "description": "HireMatch AI - Intelligent Resume Screening & Job Recommendation System",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && npm test",
    "build": "cd frontend && npm run build",
    "deploy:xampp": "bash scripts/deploy_to_xampp.sh",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "hirematch",
    "recruitment",
    "ai",
    "nlp",
    "resume-screening",
    "mca-project"
  ],
  "author": "tech-venu",
