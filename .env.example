# Server Configuration
PORT=5001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/hirematch_ai

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# AI Provider Configuration (Optional LLM integration - system provides local fallback if empty)
AI_PROVIDER=none
AI_API_KEY=

